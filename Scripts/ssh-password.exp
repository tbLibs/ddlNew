#!/usr/bin/expect -f
# The password comes from the configuration via environment, never argv.
set timeout 900
if {![info exists env(DDLNEW_SSH_PASSWORD)] || $env(DDLNEW_SSH_PASSWORD) eq ""} {
    puts stderr "未配置上传密码"
    exit 1
}
set attempts 0
spawn -noecho {*}$argv
expect {
    -re {(?i)password:} {
        incr attempts
        if {$attempts > 1} {
            puts stderr "SSH 密码认证失败"
            exit 1
        }
        send -- "$env(DDLNEW_SSH_PASSWORD)\r"
        exp_continue
    }
    timeout {
        puts stderr "SSH/SCP 操作超时"
        exit 1
    }
    eof {
        set result [wait]
        if {[lindex $result 2] != 0 || [llength $result] > 4} { exit 1 }
        exit [lindex $result 3]
    }
}
