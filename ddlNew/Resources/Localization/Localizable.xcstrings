    "只删除服务器或本机已确认成功的记录，失败项会保留选择并显示明细。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only records confirmed as deleted by the server or this device will be removed. Failed items remain selected with details shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除服务器或本机已确认成功的记录，失败项会保留选择并显示明细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪除服務器或本機已確認成功的記錄，失敗項會保留選擇並顯示明細。"
          }
        }
      }
    },
    "只影响当前账号在本机的显示，不会拒绝申请，也不会通知对方。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only hides the request for this account on this device. It will not reject the request or notify the other person."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只影响当前账号在本机的显示，不会拒绝申请，也不会通知对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只影響當前賬號在本機的顯示，不會拒絕申請，也不會通知對方。"
          }
        }
      }
    },
