      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will stop receiving messages from this person. Unblock them here or under Me → Blocked Users. Your friendship and chat history will remain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入后将不再接收对方消息。你可以在这里或“我的—黑名单”中移出，好友和聊天记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入後將不再接收對方消息。你可以在這裡或“我的—黑名單”中移出，好友和聊天記錄會保留。"
          }
        }
      }
    },
